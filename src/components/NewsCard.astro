---
// Mirrors the live /it/news/ archive template's post-card markup exactly (see
// IMPLEMENTATION_NOTES.md Task 4) — styled entirely by the self-hosted
// twentytwenty-style.min.css / style-custom.min.css (body.blog rules), plus a
// small site.css override for the card background/text color/excerpt size (see
// that file's own comment) and the whole-card "stretched link" below. No live
// posts are migrated; this only renders posts from the local content collection
// (src/content/news/), used once real ones are published.
//
// `href` links the whole card to its own /news/<slug>/ detail page (added
// alongside this card so the full article body — previously written but never
// rendered anywhere — actually becomes visible). The title text is the real
// link; `.entry-title a::after{inset:0}` in site.css stretches its click target
// to cover the entire card (image included) without restructuring the grid
// markup — `<article>` must stay the direct child of `main#site-content` for
// the vendor's grid-column rules to keep applying, so the anchor can't wrap the
// whole `<article>` from the outside.
export interface Props {
  title: string;
  excerpt?: string;
  image?: string;
  href: string;
}
const { title, excerpt, image, href } = Astro.props;
---

<article class="post">
  {
    image && (
      <figure class="featured-media">
        <div class="featured-media-inner section-inner" style={`background-image:url(${image})`} />
      </figure>
    )
  }
  <header class="entry-header">
    <div class="entry-header-inner section-inner">
      <h3 class="entry-title">
        <a href={href}>{title}</a>
      </h3>
    </div>
  </header>
  <div class="post-inner">
    <div class="entry-content">
      {excerpt && <p>{excerpt}</p>}
    </div>
  </div>
</article>
