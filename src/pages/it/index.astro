---
export const prerender = true;
import { readFile } from "node:fs/promises";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import localeEquivalents from "../../data/locale-equivalents.json";

const contentHtml = await readFile(
  path.join(process.cwd(), "src/content/main/home.html"),
  "utf8",
);
---

<BaseLayout
  title="Rigoni Vittorino"
  description="Rigoni Vittorino: azienda vinicola veneta con quasi 100 ettari di vigneti nelle migliori aree della pianura Padana. Dalla campagna al bicchiere, la nostra filosofia."
  ogTitle="Home"
  extraStyleFile="home-extra-style.css"
  bodyClass="home"
  lang="it"
  otherLangUrls={localeEquivalents.pages.home}
  showLoadingScreen
>
  <Hero />
  <div class="home-content">
    <Fragment set:html={contentHtml} />
  </div>
</BaseLayout>
