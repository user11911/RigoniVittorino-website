---
export const prerender = true;
import { readFile } from "node:fs/promises";
import path from "node:path";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import localeEquivalents from "../../../data/locale-equivalents.json";

const contentHtml = await readFile(
  path.join(process.cwd(), "src/content/main/de/privacy-policy.html"),
  "utf8",
);
---

<!--
  Previously genuinely blank (the live site only ever embedded a third-party
  Iubenda widget here, never real static text — see this file's prior comment
  in git history / IMPLEMENTATION_NOTES.md Task 9). Populated with a
  self-hosted German translation of /it/privacy-policy/'s own text once the
  user explicitly authorized it, choosing a real German translation over
  reusing the English version — GDPR requires information to be given in
  language intelligible to its audience, and the rest of this site's /de/
  tree is fully translated. Same underlying facts, same disclosed
  "AI-drafted, needs legal review" status as the Italian original — translation
  included, since translating GDPR text can itself introduce errors even when
  using standard legal terminology (Verantwortlicher, Verarbeitung,
  Einwilligung, berechtigtes Interesse, etc.). `noindex` removed now that the
  page has real content to index, matching /it/privacy-policy/'s own
  indexable state.
-->
<BaseLayout
  title="Datenschutz- und Cookie-Richtlinie - Rigoni Vittorino"
  description="Datenschutz- und Cookie-Richtlinie von Rigoni Vittorino: wie auf dieser Website erhobene Daten verarbeitet werden."
  ogTitle="Datenschutz- und Cookie-Richtlinie"
  bodyClass="singular missing-post-thumbnail"
  lang="de"
  otherLangUrls={localeEquivalents.pages["privacy-policy"]}
>
  <Fragment set:html={contentHtml} />
</BaseLayout>
