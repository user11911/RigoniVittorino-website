---
export const prerender = true;
import { readFile } from "node:fs/promises";
import path from "node:path";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "../../components/Hero.astro";
import localeEquivalents from "../../data/locale-equivalents.json";

const contentHtml = await readFile(
  path.join(process.cwd(), "src/content/main/de/home.html"),
  "utf8",
);
// Same 4 images as /it/ (confirmed language-neutral). Task 14: the per-slide
// caption text this array used to carry was removed by explicit user request —
// see .claude/TODO.md Task 14.
const slides = [
  { image: "/wp-content/uploads/2021/01/rigoni-s2-bottiglie.jpg" },
  { image: "/wp-content/uploads/2021/01/rigoni-s3-vigneti.jpg" },
  { image: "/wp-content/uploads/2021/01/rigoni-s4-famiglia.jpg" },
  { image: "/wp-content/uploads/2021/01/rigoni-s5-cantina.jpg" },
];
---

<BaseLayout
  title="Rigoni Vittorino"
  ogTitle="Home"
  extraStyleFile="home-extra-style.de.css"
  bodyClass="home"
  lang="de"
  otherLangUrls={localeEquivalents.pages.home}
  showLoadingScreen
>
  <Hero slides={slides} />
  <div class="home-content">
    <Fragment set:html={contentHtml} />
  </div>
</BaseLayout>
