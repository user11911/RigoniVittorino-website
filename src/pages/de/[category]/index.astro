---
export const prerender = true;
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WineCard from "../../../components/WineCard.astro";
import categories from "../../../data/categories.de.json";
import wines from "../../../data/wines.de.json";
import localeEquivalents from "../../../data/locale-equivalents.json";

export function getStaticPaths() {
  return categories.map((cat) => ({
    params: { category: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const categoryWines = wines.filter((w) => w.category === category.key);
// Task 37: see the IT version of this template for the full reasoning — this
// page never set bodyClass, unlike every other content page, leaving up to
// 160px of unwanted top padding (2 stacked vendor rules) that "singular
// missing-post-thumbnail" (the same pair every other content page uses) removes.
// Task 39: see the IT version of this template for the full reasoning — every
// category now uses the same bigger-bottle-photo, no-text, 2-per-row treatment
// Task 38 introduced for rossi.
const imageVariant = "bottle-large";
// Task 40: see the IT version of this template for the full reasoning.
const isSpumanti = category.key === "spumanti";
---

<BaseLayout
  title={`${category.title} - Rigoni Vittorino`}
  ogTitle={category.title}
  bodyClass="singular missing-post-thumbnail"
  lang="de"
  otherLangUrls={(localeEquivalents.categories as Record<string, { it: string; en: string; de: string }>)[category.key]}
  enableViewTransitions={isSpumanti}
>
  <article class={`page type-page status-publish hentry wines-category-${category.slug}`}>
    <header class="entry-header has-text-align-center header-footer-group">
      <div class="entry-header-inner section-inner medium">
        <h1 class="entry-title">{category.title}</h1>
      </div>
    </header>
    <div class="post-inner">
      <div class="entry-content">
        <div class="wines-row-container">
          <div class={`wine-cat-background ${category.cssClass}`}>
            <img class="category-logo-ico logo-rigoni-ico ico-color" src={category.categoryLogo} />
            <h1 class="category-title">{category.title}</h1>
          </div>
          <div class="wine-list-container wine-list-container--large">
            {
              categoryWines.map((wine) => (
                <WineCard
                  slug={wine.slug}
                  title={wine.title}
                  cardImageSrc={wine.cardImageSrc}
                  cardImageWidth={wine.cardImageWidth}
                  cardImageHeight={wine.cardImageHeight}
                  lang="de"
                  imageVariant={imageVariant}
                  viewTransitionName={isSpumanti ? `wine-bottle-${wine.slug}` : undefined}
                />
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </article>
</BaseLayout>
